@@ -1,4 +1,5 @@
 #include "dxgi_factory.h"
+#include "dxgi_d3d12.h"
 #include "dxgi_swapchain.h"
 #include "dxgi_swapchain_dispatcher.h"
 
@@ -144,9 +145,19 @@ namespace dxvk {
 
       return hr;
     }
-    
-    Logger::err("DXGI: CreateSwapChainForHwnd: Unsupported device type");
-    return DXGI_ERROR_UNSUPPORTED;
+
+    /* Native DXVK's DXGI provider normally receives a D3D11 device.  When it
+     * is also the overridden DXGI provider for vkd3d-proton, use vkd3d's
+     * Vulkan-backed swapchain frontend instead of falling through to an
+     * unsupported-device error. */
+    HRESULT hr = createD3D12SwapChain(this, pDevice, hWnd, pDesc,
+      pFullscreenDesc, pRestrictToOutput, ppSwapChain, m_instance);
+    if (SUCCEEDED(hr))
+      return hr;
+
+    if (hr == DXGI_ERROR_UNSUPPORTED)
+      Logger::err("DXGI: CreateSwapChainForHwnd: Unsupported device type");
+    return hr;
   }
   
   
