new file mode 100644
index 0000000..a258037
--- /dev/null
+++ b/src/dxgi/dxgi_d3d12.cpp
@@ -0,0 +1,195 @@
+#include "dxgi_d3d12.h"
+
+#include "dxgi_factory.h"
+#include "dxgi_swapchain.h"
+
+namespace dxvk {
+
+  DxgiWin32SurfaceFactory::DxgiWin32SurfaceFactory(
+    const Rc<DxvkInstance>& instance,
+          HWND              window)
+  : m_instance(instance), m_window(window) {
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiWin32SurfaceFactory::QueryInterface(
+          REFIID riid, void** ppvObject) {
+    if (!ppvObject)
+      return E_POINTER;
+    *ppvObject = nullptr;
+
+    if (riid == __uuidof(IUnknown) || riid == __uuidof(IDXGIVkd3dSurfaceFactory)) {
+      *ppvObject = ref(this);
+      return S_OK;
+    }
+    return E_NOINTERFACE;
+  }
+
+  VkResult STDMETHODCALLTYPE DxgiWin32SurfaceFactory::CreateSurface(
+          VkInstance instance,
+          VkPhysicalDevice adapter,
+          VkSurfaceKHR* pSurface) {
+    if (!instance || !adapter || !pSurface || !m_window)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+    HINSTANCE hinstance = reinterpret_cast<HINSTANCE>(
+      GetWindowLongPtr(m_window, GWLP_HINSTANCE));
+    VkWin32SurfaceCreateInfoKHR info;
+    info.sType = VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR;
+    info.pNext = nullptr;
+    info.flags = 0;
+    info.hinstance = hinstance;
+    info.hwnd = m_window;
+
+    VkResult status = m_instance->vki()->vkCreateWin32SurfaceKHR(
+      instance, &info, nullptr, pSurface);
+    if (status != VK_SUCCESS)
+      return status;
+
+    /* vkd3d-proton performs the presentation-support query with the actual
+     * command-queue family.  The surface factory ABI intentionally does not
+     * carry that family index, so do not guess one here. */
+    return VK_SUCCESS;
+  }
+
+  DxgiD3D12Presenter::DxgiD3D12Presenter(IDXGIVkd3dSwapChain* swapChain)
+  : m_swapChain(swapChain) {
+  }
+
+  DxgiD3D12Presenter::~DxgiD3D12Presenter() = default;
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::QueryInterface(
+          REFIID riid, void** ppvObject) {
+    if (!ppvObject)
+      return E_POINTER;
+    *ppvObject = nullptr;
+    if (riid == __uuidof(IUnknown) || riid == __uuidof(IDXGIVkSwapChain)) {
+      *ppvObject = ref(this);
+      return S_OK;
+    }
+    return E_NOINTERFACE;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::GetDesc(DXGI_SWAP_CHAIN_DESC1* desc) {
+    return m_swapChain->GetDesc(desc);
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::GetAdapter(REFIID riid, void** object) {
+    return m_swapChain->GetAdapter(riid, object);
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::GetDevice(REFIID riid, void** object) {
+    return m_swapChain->GetDevice(riid, object);
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::GetImage(
+          UINT bufferId, REFIID riid, void** buffer) {
+    return m_swapChain->GetImage(bufferId, riid, buffer);
+  }
+
+  UINT STDMETHODCALLTYPE DxgiD3D12Presenter::GetImageIndex() {
+    return m_swapChain->GetImageIndex();
+  }
+
+  UINT STDMETHODCALLTYPE DxgiD3D12Presenter::GetFrameLatency() {
+    return m_swapChain->GetFrameLatency();
+  }
+
+  HANDLE STDMETHODCALLTYPE DxgiD3D12Presenter::GetFrameLatencyEvent() {
+    return m_swapChain->GetFrameLatencyEvent();
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::ChangeProperties(
+    const DXGI_SWAP_CHAIN_DESC1* desc) {
+    return m_swapChain->ChangeProperties(desc, nullptr, nullptr);
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::SetPresentRegion(const RECT* region) {
+    return m_swapChain->SetPresentRegion(region);
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::SetGammaControl(
+          UINT numControlPoints, const DXGI_RGB* controlPoints) {
+    return m_swapChain->SetGammaControl(numControlPoints, controlPoints);
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::SetFrameLatency(UINT maxLatency) {
+    return m_swapChain->SetFrameLatency(maxLatency);
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiD3D12Presenter::Present(
+          UINT syncInterval, UINT presentFlags,
+    const DXGI_PRESENT_PARAMETERS* presentParameters) {
+    return m_swapChain->Present(syncInterval, presentFlags, presentParameters);
+  }
+
+  void STDMETHODCALLTYPE DxgiD3D12Presenter::NotifyModeChange(
+          BOOL windowed, const DXGI_MODE_DESC* displayMode) {
+    /* The vkd3d swapchain is windowed-only for this phase. */
+    (void)windowed;
+    (void)displayMode;
+  }
+
+  HRESULT createD3D12SwapChain(
+          IDXGIFactory* factory,
+          IUnknown* device,
+          HWND window,
+    const DXGI_SWAP_CHAIN_DESC1* desc,
+    const DXGI_SWAP_CHAIN_FULLSCREEN_DESC* fullscreenDesc,
+          IDXGIOutput* restrictToOutput,
+          IDXGISwapChain1** swapChain,
+    const Rc<DxvkInstance>& instance) {
+    InitReturnPtr(swapChain);
+    if (!factory || !device || !window || !desc || !swapChain)
+      return DXGI_ERROR_INVALID_CALL;
+
+    /* Flip-model rules are part of the DXGI contract.  Validate them here so
+     * malformed descriptors do not reach the vkd3d allocator (which may
+     * otherwise create an empty chain for BufferCount == 0). */
+    if ((desc->SwapEffect == DXGI_SWAP_EFFECT_FLIP_DISCARD
+      || desc->SwapEffect == DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL)
+      && (desc->BufferCount < 2 || desc->BufferCount > DXGI_MAX_SWAP_CHAIN_BUFFERS))
+      return E_INVALIDARG;
+
+    if (desc->Format != DXGI_FORMAT_B8G8R8A8_UNORM
+      && desc->Format != DXGI_FORMAT_R8G8B8A8_UNORM
+      && desc->Format != DXGI_FORMAT_B8G8R8A8_UNORM_SRGB
+      && desc->Format != DXGI_FORMAT_R8G8B8A8_UNORM_SRGB)
+      return E_INVALIDARG;
+
+    Com<IDXGIVkd3dSwapChainFactory> vkd3dFactory;
+    HRESULT hr = device->QueryInterface(__uuidof(IDXGIVkd3dSwapChainFactory),
+      reinterpret_cast<void**>(&vkd3dFactory));
+    if (FAILED(hr))
+      return DXGI_ERROR_UNSUPPORTED;
+
+    DXGI_SWAP_CHAIN_FULLSCREEN_DESC fsDesc;
+    if (fullscreenDesc) {
+      fsDesc = *fullscreenDesc;
+    } else {
+      fsDesc.RefreshRate = { 0, 0 };
+      fsDesc.ScanlineOrdering = DXGI_MODE_SCANLINE_ORDER_UNSPECIFIED;
+      fsDesc.Scaling = DXGI_MODE_SCALING_UNSPECIFIED;
+      fsDesc.Windowed = TRUE;
+    }
+
+    Com<DxgiWin32SurfaceFactory> surfaceFactory =
+      new DxgiWin32SurfaceFactory(instance, window);
+    Com<IDXGIVkd3dSwapChain> vkd3dSwapChain;
+    hr = vkd3dFactory->CreateSwapChain(surfaceFactory.ptr(), desc,
+      &vkd3dSwapChain);
+    if (FAILED(hr))
+      return hr;
+
+    Com<DxgiD3D12Presenter> presenter = new DxgiD3D12Presenter(
+      vkd3dSwapChain.ptr());
+    try {
+      *swapChain = ref(new DxgiSwapChain(factory, presenter.ptr(), window,
+        desc, &fsDesc));
+    } catch (const DxvkError& error) {
+      Logger::err(error.message());
+      return E_INVALIDARG;
+    }
+    return S_OK;
+  }
+
+}
